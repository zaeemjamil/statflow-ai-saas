# Copy to .env.production and fill in. NEVER commit .env.production.

# Your site's address, without https:// (DNS for it must point at this server).
DOMAIN=app.example.com

# Pick long random values (see DEPLOYMENT.md for the one-line command to make them).
POSTGRES_PASSWORD=
JWT_SECRET=

# --- AI analyst (optional). Leave empty to keep AI explanations switched off. ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Password-reset emails (optional but needed for "Forgot password"). ---
# EMAIL_PROVIDER=none only logs; use smtp with any mail provider's SMTP details.
EMAIL_PROVIDER=none
EMAIL_FROM_ADDRESS=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Port 587 uses STARTTLS (the defaults). For providers that require port 465, set SMTP_PORT=465 and SMTP_SSL=true.
SMTP_STARTTLS=true
SMTP_SSL=false
