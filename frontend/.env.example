# Where the Next.js server proxies /api/v1/* to (the FastAPI backend).
BACKEND_URL=http://127.0.0.1:8000
# Must match the backend's COOKIE_NAME (default: access_token).
NEXT_PUBLIC_SESSION_COOKIE=access_token
# Upload limits shown in / pre-checked by the UI. DISPLAY AND PRE-CHECK ONLY: the
# backend (MAX_CSV_UPLOAD_SIZE_MB, MAX_XLSX_UPLOAD_SIZE_MB, MAX_DATASET_ROWS,
# MAX_DATASET_COLUMNS) is the authority. Keep these equal to the backend values.
# These are inlined at build time (restart `next dev` / rebuild after changing).
NEXT_PUBLIC_MAX_CSV_UPLOAD_MB=25
NEXT_PUBLIC_MAX_XLSX_UPLOAD_MB=10
NEXT_PUBLIC_MAX_DATASET_ROWS=100000
NEXT_PUBLIC_MAX_DATASET_COLUMNS=100
# The Next.js proxy buffers request bodies up to (the larger of the two upload limits above + 2 MB);
# see next.config.ts. Raising a backend limit above 25 MB means raising the value here too.
