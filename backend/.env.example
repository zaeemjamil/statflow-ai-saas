# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Actively used in Phase 3 -----------------------------------------
ENVIRONMENT=development
# postgresql+psycopg2:// explicitly, not bare postgresql:// - SQLAlchemy
# 2.1+ changed its default driver resolution to try psycopg (v3) first,
# which fails here since only psycopg2-binary is installed. The
# explicit scheme sidesteps relying on that default at all. Confirmed
# empirically against SQLAlchemy 2.1.2 (2.0.52 did not have this issue).
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/zaimex
FRONTEND_URL=http://localhost:3000

# --- Actively used in Phase 5 (auth + password reset) ------------------
# JWT_SECRET has no safe default in production - see app/core/config.py's
# validator. The value below is fine for local dev only.
JWT_SECRET=changeme-not-a-real-secret-set-a-real-one
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=noreply@zaimex.app

# Session cookie. Defaults are the production-safe choice already -
# only COOKIE_SECURE needs overriding, and only for local dev over
# plain http:// (see app/core/config.py's model_validator for why
# COOKIE_SAMESITE=none requires COOKIE_SECURE=true).
COOKIE_NAME=access_token
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# --- Reserved for Phase 6 (uploads / object storage) --------------------
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
# Upload / dataset limits (V1). The effective byte limit per file is
# min(its per-type limit, MAX_UPLOAD_SIZE_MB), which is kept as the overall
# ceiling. Rows exclude the header row. All must be positive integers.
MAX_UPLOAD_SIZE_MB=25
MAX_CSV_UPLOAD_SIZE_MB=25
MAX_XLSX_UPLOAD_SIZE_MB=10
MAX_DATASET_ROWS=100000
MAX_DATASET_COLUMNS=100
# An .xlsx is a zip; refuse archives that unpack to more than this.
MAX_XLSX_UNCOMPRESSED_SIZE_MB=250

# --- Reserved for Phase 9 (AI analyst) ----------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
